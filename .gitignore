# Keep the repository focused on core code and project documentation.
# Add an exception here when introducing a new top-level source directory.
/*
!/.gitignore
!/README.md
!/SECURITY.md
!/LICENSE
!/LICENSE.*
!/pyproject.toml
!/main.py
!/requirements*.txt
!/environment*.yml
!/environment*.yaml
!/uv.lock
!/src/
!/tests/
!/tools/

# Python bytecode, packaging, and test/tool caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Local environments (keep dependency and environment specification files)
/.conda/
/envs/
.venv/
venv/

# Local configuration and secrets; keep shareable examples
.env
.env.*
!.env.example
!.env.sample
.claude/
.idea/
.vscode/

# Results and disposable working directories at any depth
results/
results_*/
results-*/
*_results/
*-results/
output/
outputs/
output_*/
output-*/
*_output/
*_outputs/
runs/
scratch/
scratch_*/
scratch-*/
tmp/
temp/
.tmp/
cache/
node_modules/

# Runtime logs and Slurm output (keep .sbatch job scripts)
logs/
log/
*.log
slurm-*.out
slurm-*.err

# Native build products and CMake-generated files
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
.ninja_deps
.ninja_log
build.ninja
/src/pangenie/Makefile
/src/pangenie/PanGenie
/src/pangenie/PanGenie-*
/tools/plink_bin/plink
/tools/plink_bin/prettify

# LaTeX intermediates outside the ignored manuscript directory
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm

# Editor and operating-system temporary files
*.swp
*.swo
*.bak
*.bak-*
*.orig
*.rej
*~
.DS_Store
Thumbs.db
